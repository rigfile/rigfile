FROM ubuntu:24.04
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq git ca-certificates >/dev/null && rm -rf /var/lib/apt/lists/*
RUN useradd -m dev
COPY build/rigfile /usr/local/bin/rigfile
COPY fake-claude /usr/local/bin/claude
COPY --chown=dev rig /rig
COPY scenario.sh /scenario.sh
USER dev
ENV HOME=/home/dev
CMD ["/bin/sh", "/scenario.sh"]
