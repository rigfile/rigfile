# fastlane Fastfile template for a Flutter iOS app.
# Encodes several non-obvious fixes — see SKILL.md for why each exists.
# Replace the ALL_CAPS placeholders.

default_platform(:ios)

APP_IDENTIFIER = "BUNDLE_ID"
TEAM_ID        = "TEAM_ID"
KEY_ID         = "KEY_ID"
ISSUER_ID      = "ISSUER_ID"

def api_key
  app_store_connect_api_key(
    key_id: KEY_ID,
    issuer_id: ISSUER_ID,
    key_filepath: File.expand_path("AuthKey_#{KEY_ID}.p8", __dir__),
    in_house: false
  )
end

platform :ios do
  # Flutter's pub get / pod install rewrite the generated SPM manifest with a stale
  # deployment target; only `flutter build ios` regenerates it from the real project
  # setting. Bundler's env must be cleared or flutter's internal pod install breaks.
  private_lane :ensure_flutter_spm_manifest do
    Bundler.with_unbundled_env do
      Dir.chdir("..") { sh("flutter build ios --release --no-codesign") }
    end
  end

  # build_configurations MUST be Release-only — applying manual distribution signing to
  # Debug/Profile makes simulator launches fail with "Runner cannot be opened".
  private_lane :ensure_signing do
    key = api_key
    cert(api_key: key, output_path: "fastlane/certs")
    sigh(api_key: key, app_identifier: APP_IDENTIFIER,
         output_path: "fastlane/profiles", force: true)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      targets: ["Runner"],
      build_configurations: ["Release"]
    )
  end

  desc "Build a signed release IPA"
  lane :build do
    ensure_flutter_spm_manifest
    ensure_signing
    build_app(workspace: "Runner.xcworkspace", scheme: "Runner",
              export_method: "app-store", output_directory: "build")
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    ensure_flutter_spm_manifest
    ensure_signing
    increment_build_number(
      build_number: latest_testflight_build_number(
        api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]) + 1,
      xcodeproj: "Runner.xcodeproj"
    )
    build_app(workspace: "Runner.xcworkspace", scheme: "Runner",
              export_method: "app-store", output_directory: "build")
    upload_to_testflight(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      skip_waiting_for_build_processing: true
    )
  end

  # Metadata only. individual_metadata_items avoids deliver touching sections you
  # manage elsewhere. Still crashes with "No data" if App Review Info was never
  # created — set that first.
  desc "Push App Store metadata only"
  lane :metadata do
    api_key
    upload_to_app_store(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      skip_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_app_version_update: false,
      individual_metadata_items: %w[name subtitle description keywords
                                    promotional_text support_url privacy_url],
      force: true,
      submit_for_review: false,
      automatic_release: false
    )
  end
end
